{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__tps25751-docs__search_register",
      "mcp__tps25751-docs__explain_bitfield",
      "mcp__tps25751-docs__get_register",
      "mcp__tps25751-docs__list_registers",
      "mcp__usb-pd-docs__search_register",
      "mcp__usb-pd-docs__explain_bitfield",
      "mcp__usb-pd-docs__get_register",
      "mcp__usb-pd-docs__list_registers",
      "mcp__km003c__device_info",
      "mcp__km003c__measure",
      "mcp__km003c__pd_status",
      "mcp__km003c__pd_capture_start",
      "mcp__km003c__pd_capture_wait",
      "mcp__km003c__pd_capture_mark",
      "mcp__km003c__pd_capture_stop",
      "mcp__km003c__pd_capture_read",
      "mcp__km003c__device_release",
      "mcp__km003c__stream_start",
      "mcp__km003c__stream_status",
      "mcp__km003c__stream_samples",
      "mcp__km003c__stream_stop",
      "mcp__tps25751-bench__bench_hello",
      "mcp__tps25751-bench__bench_snapshot",
      "mcp__tps25751-bench__bench_read",
      "mcp__tps25751-bench__bench_crosscheck"
    ],
    "ask": [
      "mcp__km003c__trigger_detect",
      "mcp__km003c__trigger_enter",
      "mcp__km003c__trigger_pd_source_caps",
      "mcp__km003c__trigger_pd_request",
      "mcp__km003c__trigger_fast_charge",
      "mcp__km003c__trigger_reset",
      "mcp__km003c__trigger_close",
      "mcp__km003c__trigger_raw",
      "mcp__tps25751-bench__bench_task",
      "mcp__tps25751-bench__bench_write",
      "mcp__tps25751-bench__bench_renegotiate"
    ],
    "deny": []
  },
  "plansDirectory": "./docs/plans",
  "enabledMcpjsonServers": [
    "tps25751-docs",
    "usb-pd-docs",
    "km003c",
    "tps25751-bench"
  ],
  "extraKnownMarketplaces": {
    "tps25751": {
      "source": {
        "source": "github",
        "repo": "forrestrae/TPS25751"
      }
    }
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "tps25751-bench@tps25751": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_guard.py\" claude pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_guard.py\" claude session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
