{
  "mcpServers": {
    "tps25751-docs": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "../device-register-mcp-server", "run", "server.py"],
      "env": { "DEVICE_CONFIG": "devices/tps25751/device.json" }
    },
    "usb-pd-docs": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "../device-register-mcp-server", "run", "server.py"],
      "env": { "DEVICE_CONFIG": "specifications/USB_PD/specification.json" }
    },
    "km003c": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/forrestrae/mcp-powerz-km003c@v0.2.0", "km003c-mcp"],
      "env": { "KM003C_CAPTURE_DIR": "captures" }
    },
    "tps25751-bench": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/forrestrae/TPS25751@v3.3.0#subdirectory=tools/pd-bench", "tps25751-pd-bench"]
    }
  }
}
