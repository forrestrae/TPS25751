{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "TPS25751",
  "version": "3.4.0",
  "description": "Arduino-compatible library for the TPS25751, a USB-C PD controller from Texas Instruments.",
  "keywords": "TPS25751, USBPD, Texas Instruments",
  "repository": {
    "type": "git",
    "url": "https://github.com/forrestrae/TPS25751.git"
  },
  "authors": [
    {
      "name": "Forrest Rae",
      "email": "fbr@14x.net",
      "url": "https://github.com/forrestrae",
      "maintainer": true
    }
  ],
  "license": "Apache-2.0",
  "frameworks": "arduino",
  "platforms": "*",
  "export": {
    "exclude": [
      ".github",
      ".githooks",
      ".claude",
      ".codex",
      ".cursor",
      ".idea",
      ".junie",
      ".pio",
      ".venv",
      ".vscode",
      ".mcp.json",
      ".gitignore",
      ".DS_Store",
      "**/.DS_Store",
      "AGENTS.md",
      "CLAUDE.md",
      "**/AGENTS.md",
